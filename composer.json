{
    "name": "amjadiqbal/laravel-driver-js",
    "description": "Driver.js product tours and onboarding for Laravel: build guided tours in PHP, render them with a Blade component, start them from Livewire or Alpine, and show a tour only the first time a visitor sees it (per browser).",
    "keywords": [
        "laravel",
        "laravel-package",
        "driver.js",
        "driverjs",
        "product-tour",
        "onboarding",
        "user-onboarding",
        "guided-tour",
        "walkthrough",
        "feature-highlight",
        "blade",
        "livewire",
        "alpinejs"
    ],
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/amjadiqbal/laravel-driver-js",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/laravel-driver-js/issues",
        "source": "https://github.com/amjadiqbal/laravel-driver-js",
        "docs": "https://github.com/amjadiqbal/laravel-driver-js#readme"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\DriverJS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\DriverJS\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\DriverJS\\DriverJSServiceProvider"
            ],
            "aliases": {
                "Driver": "AmjadIqbal\\DriverJS\\Facades\\Driver"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
